# Copy this file to .env.local and replace each placeholder with a local value.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=replace-with-your-application-url
AUTH_GOOGLE_ID=replace-with-your-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-your-google-oauth-client-secret
AUTH_MOCK_OAUTH_ENABLED=replace-with-true-or-false
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-your-openai-model
PORT=replace-with-your-port
DATABASE_PATH=replace-with-your-local-sqlite-path
WORKSPACE_CREDENTIAL_KEY=replace-with-a-long-random-key
AVATAR_DIRECTORY=replace-with-your-local-avatar-directory
GEMINI_API_KEY=replace-with-your-gemini-api-key
GROQ_API_KEY=replace-with-your-groq-api-key