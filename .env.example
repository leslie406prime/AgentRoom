# For a NEW installation, copy to .env.local. Never overwrite an existing environment file.
# Preserve an existing AUTH_SECRET and WORKSPACE_CREDENTIAL_KEY.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MOCK_OAUTH_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional paid provider; requires explicit workspace owner authorization as well.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
DATABASE_PATH=./data/agentroom.sqlite
# Required for production PostgreSQL; leave empty to use SQLite in development.
# Set the real pooled Neon URL only in the hosting environment, never in Git.
DATABASE_URL=
# Required only for encrypted per-workspace OpenAI credentials (32 bytes, base64).
WORKSPACE_CREDENTIAL_KEY=
AVATAR_DIRECTORY=./data/avatars
